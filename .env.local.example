# ============================================================================
# Frontend del Diagnóstico Organizacional LinkTIC
# Copie este archivo como .env.local
#
# TODO lo que lleva NEXT_PUBLIC_ queda incrustado en el bundle del navegador y es
# visible para cualquiera. Aquí van SOLO valores públicos: ningún token, ninguna
# clave de Supabase, ningún secreto de firma.
# ============================================================================

# URL base de la API de NestJS, incluyendo el prefijo de versión.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

NEXT_PUBLIC_APP_NAME=Diagnóstico Organizacional LinkTIC

# Debe coincidir con COOKIE_NAME del backend: proxy.ts la busca por nombre para
# decidir si redirige a /login.
NEXT_PUBLIC_COOKIE_NAME=linktic_admin_session

NEXT_PUBLIC_SUPPORT_EMAIL=talentohumano@linktic.com
